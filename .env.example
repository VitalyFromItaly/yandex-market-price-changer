# Шаблон переменных окружения. Скопируйте в .env и заполните значения.
#   cp .env.example .env
# Реальных секретов в этом файле быть не должно — .env в .gitignore.
#
# Перечислены все переменные, которые читает код. Если добавляете новую —
# добавьте её и сюда, иначе она молча окажется undefined.

# --- приложение --------------------------------------------------------------
# Порт HTTP-сервера. В docker-compose переопределяется на 3000.
PORT=3004

# --- MongoDB -----------------------------------------------------------------
# Строка подключения БЕЗ имени базы — имя передаётся отдельно в MONGODB_DATABASE.
# Порт 27018 — это проброс контейнера mongodb наружу (см. docker-compose.yml).
MONGODB_URL=mongodb://root:secret@localhost:27018/
MONGODB_DATABASE=yandex-market-price-changer

# --- Redis (очереди Bull) ----------------------------------------------------
# Без этих переменных Bull молча уходит на localhost:6379.
REDIS_HOST=localhost
REDIS_PORT=6379
# Оставьте пустым, если redis поднят без пароля (как в docker-compose).
# Непустое значение при выключенном auth заставляет сервер писать
# предупреждение на каждое соединение и ничего не даёт.
REDIS_PASSWORD=

# --- Telegram ----------------------------------------------------------------
# Токен бота от @BotFather.
TELEGRAM_TOKEN=
# Как забираем апдейты: webhook (Telegram стучится к нам) или polling (мы сами
# опрашиваем Bot API). По умолчанию webhook — режим локальной разработки
# через туннель.
# polling нужен там, откуда вебхук недостижим для серверов Telegram: на
# российском хостинге трафик Telegram фильтруется в ОБЕ стороны, и вебхук
# получает «Connection timed out» при полностью исправном приложении. Polling
# уходит через зеркало из TELEGRAM_API_URL, то есть по уже рабочему каналу.
TELEGRAM_UPDATE_MODE=
# Куда Telegram шлёт апдейты НАМ: публичный HTTPS-домен для вебхука,
# например ngrok: https://xxxx.ngrok-free.app
# Поднять туннель: npm run tunnel:ngrok
# (раньше ключ назывался TELEGRAM_PROXY_URL — никаким прокси он не был)
# При TELEGRAM_UPDATE_MODE=polling не нужен и не проверяется.
TELEGRAM_WEBHOOK_URL=
# Куда ходим МЫ: своё зеркало Bot API вместо api.telegram.org.
# Можно не задавать — по умолчанию https://api.telegram.org, то есть напрямую.
# ТОЛЬКО схема и хост, без пути: путь в базовом URL telegraf отбрасывает, и все
# запросы молча уйдут в 404. Правильно: https://tg-api.example.com
TELEGRAM_API_URL=
# Telegram id администраторов через запятую — им приходит карточка «Новая
# регистрация» с кнопками Одобрить/Отклонить. Первое решение побеждает.
# Свой id можно узнать у @userinfobot. Только числа, не @username.
# ВАЖНО: каждый администратор обязан САМ нажать /start у бота. Telegram не даёт
# боту написать первым — иначе ответит 403 и карточка до админа не дойдёт.
TELEGRAM_ADMIN_IDS=

# --- Yandex Market Partner API -----------------------------------------------
# Базовый URL API. Версия метода (v1/v2) добавляется в коде и обязательна —
# неверсионированные запросы Яндекс скоро отключит.
# Токен продавца здесь НЕ хранится: каждый пользователь вводит свой через бота,
# и он лежит в БД, скоупленный по telegramUserId.
YANDEX_MARKET_BASE_URL=https://api.partner.market.yandex.ru
