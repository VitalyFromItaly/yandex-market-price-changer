{
  "name": "tg-bot-yandex-market-price-changer",
  "version": "0.0.0",
  "description": "tg-bot-yandex-market-price-changer for Telegram bots using Node.js, TypeScript, and Express.",
  "engines": {
    "node": ">= 20 < 23"
  },
  "main": "src/main.ts",
  "scripts": {
    "start": "node --enable-source-maps dist/main.js",
    "start:prod": "npm run build && npm run start",
    "dev": "nodemon",
    "clean": "rimraf coverage dist tmp",
    "build": "nest build && npm run build:web",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "tunnel": "vk-tunnel --insecure=1 --http-protocol=http --ws-protocol=ws --host=localhost --port=3004 --timeout=5000",
    "tunnel:ngrok": "ngrok http http://localhost:3004",
    "prettier-fix": "prettier --write ./src",
    "api": "openapi --input src/modules/yandex/api-docs/openapi/openapi.yaml --output src/modules/yandex/api",
    "parser:run": "npx ts-node src/modules/parser/run-simple-parser.ts",
    "image:fetch-model": "ts-node scripts/fetch-bg-model.ts",
    "image:compose": "ts-node scripts/compose-product-image.ts",
    "db:sync-indexes": "ts-node scripts/sync-indexes.ts",
    "db:clean": "ts-node scripts/clean-db.ts",
    "prettier:check": "prettier --check ./src",
    "typecheck": "tsc --noEmit",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts"
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "~9.17",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.28",
    "@swc/core": "^1.15.46",
    "@types/bcrypt": "^6.0.0",
    "@types/eslint__js": "~8.42",
    "@types/express": "^5.0.0",
    "@types/lodash": "^4.17.15",
    "@types/node": "^20.19.0",
    "@typescript-eslint/parser": "~8.19",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "~2.1",
    "@vitest/eslint-plugin": "~1.1",
    "eslint": "~9.17",
    "eslint-config-prettier": "~9.1",
    "eslint-plugin-import": "^2.32.0",
    "globals": "~15.14",
    "localtunnel": "^2.0.2",
    "nodemon": "^3.1.9",
    "prettier": "~3.4",
    "rimraf": "~6.0",
    "ts-api-utils": "~2.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.7",
    "typescript-eslint": "~8.19",
    "unplugin-swc": "^1.5.9",
    "vite": "^5.4.21",
    "vitest": "~2.1",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "author": "perekutnev@gmail.com",
  "license": "Apache-2.0",
  "dependencies": {
    "@clickhouse/client": "^1.10.1",
    "@nestjs/bull": "^11.0.2",
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.3",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-express": "^11.1.3",
    "@types/bull": "^4.10.4",
    "@types/uuid": "^10.0.0",
    "axios": "1.8.2",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.3",
    "bull": "^4.16.5",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.7",
    "env-cmd": "^10.1.0",
    "express": "^4.21.2",
    "iconv-lite": "^0.6.3",
    "joi": "^17.13.3",
    "lodash": "^4.17.21",
    "mitt": "^3.0.1",
    "mongoose": "^8.10.1",
    "onnxruntime-node": "^1.27.0",
    "openapi-typescript-codegen": "^0.29.0",
    "redis": "^5.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.3",
    "technicalindicators": "^3.1.0",
    "telegraf": "^4.16.3",
    "ts-patch": "^3.3.0",
    "tslib": "~2.8",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5"
  },
  "volta": {
    "node": "22.12.0"
  }
}
